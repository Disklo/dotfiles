    vec3 cmask1 = one;
    vec3 cmask2 = one;
    float mwidths[15] = float[15](2., 3., 3., 6., 6., 2.4, 3.4, 2.4, 3.25, 3.4, 4.4, 4.25, 7.4, 6.25, 5.25);
    float mwidth = mwidths[int(params.shadowMask)];
    float mask_compensate = fract(mwidth);
    float mwidth1 = mwidth;
    if (params.shadowMask > -0.5) {
        vec2 maskcoord = (vTexCoord * global.OutputSize.xy).yx;
        if (notate) maskcoord = maskcoord.yx;
        vec2 scoord = maskcoord;
        mwidth = floor(mwidth) * params.masksize;
        float swidth = mwidth;
        bool zoomed = abs(global.mask_zoom) > 0.75;
        float mscale = 1.;
        vec2 maskcoord0 = maskcoord;
        maskcoord.y = floor(maskcoord.y / params.masksize);
        mwidth1 = max(mwidth + global.mask_zoom, 2.);
        if (params.mshift > 0.25) {
            float stagg_lvl = 1.;
            if (fract(params.mshift) > 0.25) stagg_lvl = 2.;
            float next_line = float(floor(mod(maskcoord.y, 2. * stagg_lvl)) < stagg_lvl);
            maskcoord0.x = maskcoord0.x + next_line * 0.5 * mwidth1;
        }
        maskcoord = maskcoord0 / params.masksize;
        if (!zoomed) cmask = fragment_Mask(floor(maskcoord), mx, mb); else {
            mscale = mwidth1 / mwidth;
            float mlerp = fract(maskcoord.x / mscale);
            if (global.mzoom_sh > 0.025) mlerp = clamp((1. + global.mzoom_sh) * mlerp - 0.5 * global.mzoom_sh, 0., 1.);
            float mcoord = floor(maskcoord.x / mscale);
            if (params.shadowMask == 12. && global.mask_zoom == -2.) mcoord = ceil(maskcoord.x / mscale);
            cmask = mix(fragment_Mask(vec2(mcoord, maskcoord.y), mx, mb), fragment_Mask(vec2(mcoord + 1., maskcoord.y), mx, mb), mlerp);
        }
        float sm_offset = 0.;
        bool bsm_offset = params.shadowMask == 0. || params.shadowMask == 2. || params.shadowMask == 5. || params.shadowMask == 6. || params.shadowMask == 8. || params.shadowMask == 11.;
        if (zoomed) {
            if (params.mask_layout < 0.5 && bsm_offset) sm_offset = 1.; else if (bsm_offset) sm_offset = -1.;
        }
        swidth = round(mwidth1);
        if (params.slotwidth > 0.5) swidth = params.slotwidth;
        float smask = 1.;
        smask = fragment_SlotMask(scoord + vec2(sm_offset, 0.), mx, swidth);
        smask = clamp(smask + mix(global.smask_mit, 0., w3 * pow(colmx, 0.3)), 0., 1.);
        cmask2 = cmask;
        cmask *= smask;
        cmask1 = cmask;
        if (abs(params.mask_bloom) > 0.025) {
            float maxbl = max(max(max(Bloom.r, Bloom.g), Bloom.b), mxg);
            maxbl = maxbl * max(mix(1., 2. - colmx, global.bloom_dist), 0.);
            if (params.mask_bloom > 0.025) cmask = max(min(cmask + maxbl * params.mask_bloom, 1.), cmask); else cmask = max(mix(cmask, cmask * (1. - 0.5 * maxbl) + fragment_plant(pow(Bloom, 0.35.xxx), maxbl), -params.mask_bloom), cmask);
        }
        color = pow(color, vec3(global.mask_gamma / gamma_in));
        color = color * cmask;
        color = min(color, 1.);
        color = pow(color, vec3(gamma_in / global.mask_gamma));
        cmask = min(cmask, 1.);
        cmask1 = min(cmask1, 1.);
    }
    float dark_compensate = mix(max(clamp(mix(params.mcut, params.maskstr, mx), 0., 1.) - 1. + mask_compensate, 0.) + 1., 1., mx);
    if (params.shadowMask < -0.5) dark_compensate = 1.;
    float bb = mix(params.brightboost, params.brightboost1, mx) * dark_compensate;
    color *= bb;
    vec3 Ref = texture(LinearizePass, pos).rgb;
    float maxb = texture(BloomPass, pos).a;
    float vig = texture(PrePass, clamp(pos, 0. + 0.5 * global.OriginalSize.zw, 1. - 0.5 * global.OriginalSize.zw)).a;
    if (params.pr_scan > 0.025) {
        float mbl = max(max(Bloom.r, Bloom.g), Bloom.b);
        Bloom = mix(Bloom, mix(Bloom, fragment_plant(orig1, mbl), min(2.5 * (1. - w3), 1.)), min(2. * params.pr_scan, 1.));
    }
    vec3 Bloom1 = Bloom;
    vec3 bcmask = mix(one, cmask1, global.bmask1);
    vec3 hcmask = mix(one, cmask1, global.hmask1);
    if (abs(global.bloom) > 0.025) {
        if (global.bloom < -0.01) Bloom1 = fragment_plant(Bloom, maxb);
        Bloom1 = min(Bloom1 * (orig1 + color), max(0.5 * (colmx + orig1 - color), 0.001 * Bloom1));
        Bloom1 = 0.5 * (Bloom1 + mix(Bloom1, mix(colmx * orig1, Bloom1, 0.5), 1. - color));
        Bloom1 = bcmask * Bloom1 * max(mix(1., 2. - colmx, global.bloom_dist), 0.);
        color = pow(pow(color, vec3(global.mask_gamma / gamma_in)) + abs(global.bloom) * pow(Bloom1, vec3(global.mask_gamma / gamma_in)), vec3(gamma_in / global.mask_gamma));
    }
    if (global.halation > 0.01) {
        Bloom = 0.5 * (Bloom + Bloom * Bloom);
        float mbl = max(max(Bloom.r, Bloom.g), Bloom.b);
        float cmxh = 0.5 * (colmx + colmx * colmx);
        mbl = mix(mix(cmxh, mix(cmxh, mbl, mbl), colmx), mbl, mb);
        Bloom = fragment_plant(Bloom, mix(sqrt(mbl * cmxh), max(mbl - 0.15 * (1. - colmx), 0.4 * cmxh), pow(colmx, 0.25))) * mix(0.425, 1., colmx);
        Bloom = (3. - colmx - color) * fragment_plant(0.325 + orig1 / w3, 0.5 * (1. + w3)) * hcmask * Bloom;
        color = pow(pow(color, vec3(global.mask_gamma / gamma_in)) + global.halation * pow(Bloom, vec3(global.mask_gamma / gamma_in)), vec3(gamma_in / global.mask_gamma));
    } else if (global.halation < -0.01) {
        float mbl = max(max(Bloom.r, Bloom.g), Bloom.b);
        Bloom = fragment_plant(Bloom + Ref + orig1 + Bloom * Bloom * Bloom, min(mbl * mbl, 0.75));
        Bloom = 2. * mix(1., w3, 0.5 * colmx) * hcmask * Bloom;
        color = color - global.halation * Bloom;
    }
    color = min(color, 1.);
    color = fragment_gc2(color, w3);
    if (global.smoothmask > 0.125) {
        float w4 = pow(w3, 0.425 + 0.3 * global.smoothmask);
        w4 = max(w4 - 0.175 * colmx * global.smoothmask, 0.2);
        color = mix(min(color / w4, fragment_plant(orig1, 1. + 0.175 * colmx * global.smoothmask)) * w4, color, w4);
    }
    if (global.m_glow < 0.5) Glow = mix(Glow, 0.25 * color, colmx); else {
        maxb = max(max(Glow.r, Glow.g), Glow.b);
        vec3 orig2 = fragment_plant(orig1 + 0.001 * Ref, 1.);
        Bloom = fragment_plant(Glow, 1.);
        Ref = abs(orig2 - Bloom);
        mx0 = max(max(orig2.r, orig2.g), orig2.b) - min(min(orig2.r, orig2.g), orig2.b);
        mx2 = max(max(Bloom.r, Bloom.g), Bloom.b) - min(min(Bloom.r, Bloom.g), Bloom.b);
        Bloom = mix(maxb * min(Bloom, orig2), mix(mix(Glow, max(max(Ref.r, Ref.g), Ref.b) * Glow, max(mx, mx0)), mix(color, Glow, mx2), max(mx0, mx2) * Ref), min(sqrt((1.1 - mx0) * (0.1 + mx2)), 1.));
        if (global.m_glow > 1.5) Glow = mix(0.5 * Glow * Glow, Bloom, Bloom);
        Glow = mix(global.m_glow_low * Glow, global.m_glow_high * Bloom, pow(colmx, global.m_glow_dist / gamma_in));
    }
    if (global.m_glow < 0.5) {
        if (params.glow >= 0.) color = color + 0.5 * Glow * params.glow; else color = color + abs(params.glow) * min(cmask2 * cmask2, 1.) * Glow;
    } else {
        vec3 cmaskg = clamp(mix(one, cmask1, global.m_glow_mask), 0., 1.);
        color = color + abs(params.glow) * cmaskg * Glow;
    }
    color = min(color, 1.);
    if (global.edgemask > 0.05) {
        mx0 = texture(Source, pos1 - dx).a;
        mx0 = texture(Source, pos1 - dx * (1. - 0.75 * sqrt(mx0))).a;
        mx2 = texture(Source, pos1 + dx).a;
        mx2 = texture(Source, pos1 + dx * (1. - 0.75 * sqrt(mx2))).a;
        float mx3 = texture(Source, pos1 - 4. * dx).a;
        float mx4 = texture(Source, pos1 + 4. * dx).a;
        mx4 = max(pow(abs(mx3 - mx4), 0.55 - 0.4 * cx), min(max(mx3, mx4) / min(0.1 + cx, 1.), 1.));
        mb = 1. - abs(pow(mx0, 1. - 0.65 * mx2) - pow(mx2, 1. - 0.65 * mx0));
        mb = mx4 * global.edgemask * (1.0001 - mb * mb);
        vec3 temp = mix(color, orig1, mb);
        color = max(temp + mix(3.5 * mb * mix(1.625 * temp, temp, cx), 0..xxx, pow(color, 0.75.xxx - 0.5 * colmx)), color);
    }
    color = color * mix(1., mix(0.5 * (1. + w3), w3, mx), params.pr_scan);
    color = min(color, max(orig1, color) * mix(one, cmask1, global.mclip));
    color = pow(color, vec3(1. / global.gamma_out));
    float rc = 0.6 * sqrt(max(max(color.r, color.g), color.b)) + 0.4;
    if (abs(global.addnoised) > 0.01) {
        vec3 noise0 = fragment_noise(vec3(floor(global.OutputSize.xy * vTexCoord / global.noiseresd), float(global.FrameCount)));
        if (global.noisetype < 0.5) color = mix(color, noise0, 0.25 * abs(global.addnoised) * rc); else color = min(color * mix(1., 1.5 * noise0.x, 0.5 * abs(global.addnoised)), 1.);
    }
    colmx = max(max(orig1.r, orig1.g), orig1.b);
    color = color + global.bmask * mix(cmask2, 0.125 * (1. - colmx) * color, min(20. * colmx, 1.));
    FragColor = mix(vec4(color * vig * fragment_humbar(mix(pos.y, pos.x, global.bardir)) * global.post_br * fragment_corner(posb), 1.), texture(StockPass, (floor(pos1 * global.OriginalSize.xy) + 0.5) * global.OriginalSize.zw), step(pos1.x, global.oimage - 0.00025));
}

vec4 hook() {
    vertex_main();
    fragment_main();
    return delinearize(FragColor);
}

